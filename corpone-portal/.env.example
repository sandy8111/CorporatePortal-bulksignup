# Database (SQLite for local dev; use postgresql+psycopg://user:pass@host/db for RDS)
CORPONE_DATABASE_URL=sqlite:///./data/corpone.db

# Contract storage: "s3" for AWS S3, "local" for ./data/uploads
CORPONE_STORAGE_BACKEND=s3
CORPONE_S3_BUCKET=corpone-contracts
CORPONE_AWS_REGION=ap-southeast-1

# Email: "console" (writes .eml files to ./data/outbox), "smtp", or "ses"
CORPONE_EMAIL_BACKEND=console
CORPONE_EMAIL_FROM=noreply@corpone.sg
CORPONE_SMTP_HOST=
CORPONE_SMTP_PORT=587
CORPONE_SMTP_USER=
CORPONE_SMTP_PASSWORD=

# eSIM activation (SGP.22 SM-DP+ address used when a SIM row has none)
CORPONE_DEFAULT_SMDP_ADDRESS=smdp.corpone.sg

# Telco network + billing API: "mock" or "http"
CORPONE_TELCO_API_MODE=mock
CORPONE_NETWORK_API_BASE_URL=https://network-api.corpone.internal
CORPONE_BILLING_API_BASE_URL=https://billing-api.corpone.internal
CORPONE_TELCO_API_KEY=

# Token required in the X-Admin-Token header for inventory / blacklist admin endpoints
CORPONE_ADMIN_TOKEN=change-me

# --- Account officer email-OTP login
CORPONE_OTP_PEPPER=generate-a-long-random-secret
CORPONE_OTP_TTL_SECONDS=300
CORPONE_OTP_MAX_ATTEMPTS=5
CORPONE_SESSION_TTL_HOURS=8
CORPONE_COOKIE_SECURE=true
# TESTING ONLY: fixed sign-in code for one test account, for environments without email delivery.
# Both lines are needed. Other emails still get a random code. Leave empty in production.
# CORPONE_DEV_FIXED_OTP=123456
# CORPONE_DEV_FIXED_OTP_EMAIL=admin@corp1.com.sg

# --- Inbound gateway (/gateway/v1): default per-key limit when none is set on the key
CORPONE_GATEWAY_DEFAULT_RATE_PER_MIN=60

# --- Outbound gateway policy for network / billing / AI upstreams
CORPONE_OUTBOUND_MAX_RETRIES=2
CORPONE_OUTBOUND_BACKOFF_SECONDS=0.5
CORPONE_OUTBOUND_BREAKER_THRESHOLD=5
CORPONE_OUTBOUND_BREAKER_COOLDOWN_SECONDS=30
CORPONE_OUTBOUND_RATE_PER_SEC=20

# --- AI contract review: "disabled", "anthropic" (needs ANTHROPIC_API_KEY) or "bedrock" (AWS credentials)
CORPONE_AI_PROVIDER=disabled
# CORPONE_AI_MODEL=            # default claude-opus-5-5 (anthropic) / anthropic.claude-opus-5-5 (bedrock)
CORPONE_AI_RATE_PER_SEC=2
