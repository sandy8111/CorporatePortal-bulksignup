<mxfile host="Electron" agent="corpone-docs-generator" version="24.7.0"><diagram id="agentcore-architecture" name="corpone-agentcore"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1440" pageHeight="1140" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value='&lt;span style="font-size:22px;font-weight:bold;"&gt;corpone-agentcore · architecture&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#6b7787;"&gt;CorpOne assistant on Amazon Bedrock AgentCore · numbered arrows = one assistant request · KEY = credential used on that hop · region ap-southeast-1 (Singapore)&lt;/span&gt;' style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="12" width="1500" height="52" as="geometry"/></mxCell><mxCell id="c2" value="Users" style="rounded=1;whiteSpace=wrap;html=1;arcSize=1;fillColor=none;dashed=1;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=13;fontStyle=1;strokeColor=#0a58ca;fontColor=#0a58ca;" vertex="1" parent="1"><mxGeometry x="20" y="80" width="240" height="640" as="geometry"/></mxCell><mxCell id="c3" value="AWS account · ap-southeast-1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=1;fillColor=none;dashed=1;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=13;fontStyle=1;strokeColor=#c77700;fontColor=#8a4b00;" vertex="1" parent="1"><mxGeometry x="340" y="80" width="1080" height="1000" as="geometry"/></mxCell><mxCell id="c4" value="Amazon Bedrock AgentCore" style="rounded=1;whiteSpace=wrap;html=1;arcSize=1;fillColor=none;dashed=1;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=13;fontStyle=1;strokeColor=#c77700;fontColor=#c77700;dashed=0;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="370" y="230" width="690" height="450" as="geometry"/></mxCell><mxCell id="c5" value="CorpOne portal (hosted in AWS, HTTPS)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=1;fillColor=none;dashed=1;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=13;fontStyle=1;strokeColor=#1e7e34;fontColor=#1e7e34;" vertex="1" parent="1"><mxGeometry x="1120" y="230" width="280" height="580" as="geometry"/></mxCell><mxCell id="c6" value="Observability and evaluation" style="rounded=1;whiteSpace=wrap;html=1;arcSize=1;fillColor=none;dashed=1;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=13;fontStyle=1;strokeColor=#6b7787;fontColor=#3c4858;dashed=0;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="370" y="840" width="1030" height="220" as="geometry"/></mxCell><mxCell id="c7" value='&lt;b&gt;Account officer&lt;/b&gt;&lt;br&gt;&lt;span style="color:#4b5563;"&gt;Cognito group &lt;b&gt;officer&lt;/b&gt; (default)&lt;br&gt;tools: listPlans, validateUen&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;spacingRight=6;fontSize=11;fillColor=#e8f0fe;strokeColor=#0a58ca;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="200" height="74" as="geometry"/></mxCell><mxCell id="c8" value='&lt;b&gt;CorpOne ops&lt;/b&gt;&lt;br&gt;&lt;span style="color:#4b5563;"&gt;Cognito group &lt;b&gt;ops&lt;/b&gt;&lt;br&gt;all 6 tools; retry needs "yes, retry"&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;spacingRight=6;fontSize=11;fillColor=#e8f0fe;strokeColor=#0a58ca;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="210" width="200" height="74" as="geometry"/></mxCell><mxCell id="c9" value='&lt;span style="font-size:10px;color:#4b5563;"&gt;both use the chat client below&lt;/span&gt;' style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="288" width="200" height="20" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Chat client / portal widget&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#4b5563;&quot;&gt;signs the user in, then calls the Runtime with the user's access token and a session id&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;spacingRight=6;fontSize=11;fillColor=#e8f0fe;strokeColor=#0a58ca;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="360" width="200" height="110" as="geometry"/></mxCell><mxCell id="c11" value='&lt;b&gt;Engineer (deploy / CI)&lt;/b&gt;&lt;br&gt;&lt;span style="color:#4b5563;"&gt;infra/deploy.py (dry run, --apply)&lt;br&gt;agent/build_and_push.sh&lt;br&gt;evals/run_offline_eval.py --batch&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;spacingRight=6;fontSize=11;fillColor=#e8f0fe;strokeColor=#0a58ca;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="590" width="200" height="96" as="geometry"/></mxCell><mxCell id="c12" value='&lt;b&gt;Amazon Cognito&lt;/b&gt;&lt;br&gt;&lt;span style="color:#4b5563;"&gt;user pool, groups officer / ops&lt;br&gt;SRP sign-in, 60-minute access tokens&lt;/span&gt;&lt;br&gt;&lt;span style="color:#7c4a03;font-weight:bold;"&gt;KEY&lt;/span&gt; &lt;span style="color:#7c4a03;"&gt;access token: sub, client_id, cognito:groups&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;spacingRight=6;fontSize=11;fillColor=#f4f1ff;strokeColor=#6d4bd1;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="400" y="110" width="240" height="96" as="geometry"/></mxCell><mxCell id="c13" value='&lt;b&gt;Amazon ECR&lt;/b&gt;&lt;br&gt;&lt;span style="color:#4b5563;"&gt;corpone-assistant image (linux/arm64), scan on push&lt;br&gt;pushed by agent/build_and_push.sh, pulled by the Runtime&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;spacingRight=6;fontSize=11;fillColor=#f4f1ff;strokeColor=#6d4bd1;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1140" y="110" width="250" height="96" as="geometry"/></mxCell><mxCell id="c14" value='&lt;b&gt;Amazon Bedrock&lt;/b&gt;&lt;br&gt;&lt;span style="color:#4b5563;"&gt;model MODEL_ID (e.g. Claude)&lt;/span&gt;&lt;br&gt;&lt;span style="color:#7c4a03;font-weight:bold;"&gt;KEY&lt;/span&gt; &lt;span style="color:#7c4a03;"&gt;Runtime IAM role: bedrock:InvokeModel&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;spacingRight=6;fontSize=11;fillColor=#f4f1ff;strokeColor=#6d4bd1;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="400" y="720" width="240" height="82" as="geometry"/></mxCell><mxCell id="c15" value='&lt;b&gt;AgentCore Policy (Cedar)&lt;/b&gt;&lt;br&gt;&lt;span style="color:#4b5563;"&gt;10 everyone: listPlans, validateUen&lt;br&gt;20 ops: inventory, blacklist, accounts&lt;br&gt;30 ops: retryProvisioning (CA…)&lt;br&gt;40 forbid retry unless ops&lt;br&gt;LOG_ONLY, then ENFORCE · kill switch&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;spacingRight=6;fontSize=11;fillColor=#fff4e5;strokeColor=#c77700;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="800" y="252" width="240" height="118" as="geometry"/></mxCell><mxCell id="c16" value='&lt;b&gt;AgentCore Runtime&lt;/b&gt;&lt;br&gt;&lt;span style="color:#4b5563;"&gt;&lt;b&gt;corpone_assistant&lt;/b&gt; (Strands)&lt;br&gt;JWT authorizer (Cognito)&lt;br&gt;Authorization header passed through&lt;br&gt;tools and prompt from cognito:groups&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;spacingRight=6;fontSize=11;fillColor=#fff4e5;strokeColor=#c77700;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="400" y="410" width="240" height="112" as="geometry"/></mxCell><mxCell id="c17" value='&lt;b&gt;AgentCore Gateway (MCP)&lt;/b&gt;&lt;br&gt;&lt;span style="color:#4b5563;"&gt;JWT authorizer (same Cognito client)&lt;br&gt;target &lt;b&gt;CorpOnePortal&lt;/b&gt;: 6 tools from portal code&lt;br&gt;semantic tool search · uploads excluded&lt;br&gt;&lt;span style="font-size:10px;"&gt;role: AuthorizeAction, GetPolicyEngine, GetResourceApiKey&lt;/span&gt;&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;spacingRight=6;fontSize=11;fillColor=#fff4e5;strokeColor=#c77700;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="800" y="410" width="240" height="112" as="geometry"/></mxCell><mxCell id="c18" value='&lt;b&gt;AgentCore Memory&lt;/b&gt;&lt;br&gt;&lt;span style="color:#4b5563;"&gt;short-term events only&lt;br&gt;NRIC/FIN and emails masked&lt;br&gt;7-day expiry · actor = token sub&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;spacingRight=6;fontSize=11;fillColor=#fff4e5;strokeColor=#c77700;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="400" y="570" width="240" height="86" as="geometry"/></mxCell><mxCell id="c19" value='&lt;b&gt;AgentCore Identity&lt;/b&gt;&lt;br&gt;&lt;span style="color:#4b5563;"&gt;token vault: portal API key (cpk_…)&lt;br&gt;API-key credential provider&lt;/span&gt;&lt;br&gt;&lt;span style="color:#7c4a03;font-weight:bold;"&gt;KEY&lt;/span&gt; &lt;span style="color:#7c4a03;"&gt;never in agent code or env&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;spacingRight=6;fontSize=11;fillColor=#fff4e5;strokeColor=#c77700;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="800" y="570" width="240" height="86" as="geometry"/></mxCell><mxCell id="c20" value='&lt;b&gt;/gateway/v1 (partner API)&lt;/b&gt;&lt;br&gt;&lt;span style="color:#4b5563;"&gt;listPlans · validateUen · getInventorySummary · checkBlacklist · getAccountStatus · retryProvisioning&lt;/span&gt;&lt;br&gt;&lt;span style="color:#7c4a03;font-weight:bold;"&gt;KEY&lt;/span&gt; &lt;span style="color:#7c4a03;"&gt;X-API-Key: scoped key, rate limit, audit row&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;spacingRight=6;fontSize=11;fillColor=#e7f6ec;strokeColor=#1e7e34;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1140" y="410" width="240" height="112" as="geometry"/></mxCell><mxCell id="c21" value='&lt;b&gt;Portal and back office&lt;/b&gt;&lt;br&gt;&lt;span style="color:#4b5563;"&gt;sign-up wizard, inventory, orders&lt;br&gt;CORPONE_TRUSTED_PROXIES&lt;br&gt;OTel spans: request id, caller kind only&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;spacingRight=6;fontSize=11;fillColor=#e7f6ec;strokeColor=#1e7e34;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1140" y="570" width="240" height="86" as="geometry"/></mxCell><mxCell id="c22" value='&lt;b&gt;Database&lt;/b&gt;&lt;br&gt;&lt;span style="color:#4b5563;"&gt;RDS Postgres (prod) · SQLite (dev)&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;spacingRight=6;fontSize=11;fillColor=#e7f6ec;strokeColor=#1e7e34;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1140" y="700" width="240" height="56" as="geometry"/></mxCell><mxCell id="e23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#1b2533;strokeWidth=1.6;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#6b7787;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c20" target="c21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#1b2533;strokeWidth=1.6;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#6b7787;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c21" target="c22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c25" value='&lt;b&gt;AgentCore Evaluations&lt;/b&gt;&lt;br&gt;&lt;span style="color:#4b5563;"&gt;online: 10% of sessions&lt;br&gt;GoalSuccess, ToolSelection, Helpfulness, Correctness&lt;br&gt;offline gate: evals/dataset.jsonl (12)&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;spacingRight=6;fontSize=11;fillColor=#f1f3f6;strokeColor=#6b7787;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="400" y="880" width="250" height="100" as="geometry"/></mxCell><mxCell id="c26" value='&lt;b&gt;Amazon CloudWatch&lt;/b&gt;&lt;br&gt;&lt;span style="color:#4b5563;"&gt;Transaction Search: aws/spans&lt;br&gt;runtime and gateway logs, policy decisions&lt;br&gt;GenAI observability&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;spacingRight=6;fontSize=11;fillColor=#f1f3f6;strokeColor=#6b7787;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="760" y="880" width="290" height="100" as="geometry"/></mxCell><mxCell id="c27" value='&lt;b&gt;CloudWatch Omni&lt;/b&gt;&lt;br&gt;&lt;span style="color:#4b5563;"&gt;one view of portal + agent traces&lt;br&gt;enterprise SSO (web UI / VS Code)&lt;br&gt;AI assistant · AWS DevOps Agent investigations&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;spacingRight=6;fontSize=11;fillColor=#f1f3f6;strokeColor=#6b7787;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1100" y="880" width="280" height="100" as="geometry"/></mxCell><mxCell id="c28" value='&lt;span style="font-size:10px;color:#6b7787;"&gt;ADOT in the agent image · OpenTelemetry in the portal · no prompt text, token or email on spans&lt;/span&gt;' style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="400" y="1000" width="900" height="24" as="geometry"/></mxCell><mxCell id="e29" value='&lt;span style="background:#1b2533;color:#ffffff;font-weight:bold;"&gt;&amp;nbsp;1&amp;nbsp;&lt;/span&gt;&amp;nbsp;sign in (SRP)' style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#1b2533;strokeWidth=1.6;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.2;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c10" target="c12"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="300" y="382"/><mxPoint x="300" y="158"/></Array></mxGeometry></mxCell><mxCell id="e30" value='&lt;span style="background:#1b2533;color:#ffffff;font-weight:bold;"&gt;&amp;nbsp;2&amp;nbsp;&lt;/span&gt;&amp;nbsp;POST /invocations&lt;br&gt;Bearer token&lt;br&gt;+ session id' style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#1b2533;strokeWidth=1.6;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.96;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c10" target="c16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e31" value='&lt;span style="background:#1b2533;color:#ffffff;font-weight:bold;"&gt;&amp;nbsp;3&amp;nbsp;&lt;/span&gt;&amp;nbsp;history / save turn' style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#1b2533;strokeWidth=1.6;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c16" target="c18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e32" value='&lt;span style="background:#1b2533;color:#ffffff;font-weight:bold;"&gt;&amp;nbsp;4&amp;nbsp;&lt;/span&gt;&amp;nbsp;model&lt;br&gt;