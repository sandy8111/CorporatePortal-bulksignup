# Copy to infra/.env, fill in, then:  set -a; . infra/.env; set +a; python infra/deploy.py
PROJECT=corpone-agentcore
AWS_REGION=ap-southeast-1                 # Singapore: keep NRIC/PDPA data in-country
# AWS_ACCOUNT_ID=                         # optional; read from STS when deploying

# The portal's public HTTPS gateway base (AgentCore Gateway calls it from the internet)
PORTAL_GATEWAY_URL=https://portal.example.sg/gateway

# Bedrock model or inference profile for the assistant (check availability in your region)
MODEL_ID=

# Agent image in ECR, linux/arm64 (agent/build_and_push.sh prints this)
AGENT_IMAGE_URI=

# LOG_ONLY first; check policy decisions in CloudWatch, then: python infra/deploy.py --apply --policy-mode ENFORCE
POLICY_MODE=LOG_ONLY
EVAL_SAMPLING_PERCENT=10
MEMORY_EXPIRY_DAYS=7

# Do NOT put PORTAL_API_KEY in this file. Export it in your shell for the deploy only:
#   export PORTAL_API_KEY=cpk_...   (portal back office > API gateway clients; scopes:
#   plans:read validation:read inventory:read accounts:read provisioning:write)
