<mxfile host="Electron" agent="corpone-docs-generator" version="24.7.0"><diagram id="integration" name="Integration and credentials"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1680" pageHeight="1676" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value='&lt;span style="font-size:22px;font-weight:bold;"&gt;CorpOne Corporate Portal · integration points and credentials&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#6b7787;"&gt;Every connection into and out of the app, the credential it uses, and how that credential is stored · test environment today, production recommendation tagged&lt;/span&gt;' style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="15" width="1400" height="55" as="geometry"/></mxCell><mxCell id="c2" value="CALLERS" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontStyle=1;fontColor=#6b7787;" vertex="1" parent="1"><mxGeometry x="30" y="82" width="210" height="20" as="geometry"/></mxCell><mxCell id="c3" value="INBOUND · PROTOCOL AND CREDENTIAL" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontStyle=1;fontColor=#6b7787;" vertex="1" parent="1"><mxGeometry x="270" y="82" width="330" height="20" as="geometry"/></mxCell><mxCell id="c4" value="CORPONE-PORTAL (FASTAPI :8501)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontStyle=1;fontColor=#6b7787;" vertex="1" parent="1"><mxGeometry x="630" y="82" width="380" height="20" as="geometry"/></mxCell><mxCell id="c5" value="OUTBOUND · PROTOCOL AND CREDENTIAL" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontStyle=1;fontColor=#6b7787;" vertex="1" parent="1"><mxGeometry x="1040" y="82" width="340" height="20" as="geometry"/></mxCell><mxCell id="c6" value="SYSTEMS CALLED" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontStyle=1;fontColor=#6b7787;" vertex="1" parent="1"><mxGeometry x="1410" y="82" width="230" height="20" as="geometry"/></mxCell><mxCell id="c7" value='corpone-portal&lt;br&gt;&lt;span style="font-weight:normal;font-size:11px;color:#6b7787;"&gt;uvicorn :8501 · secrets read from .env / CORPONE_* at startup&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=2;fillColor=#fcfdff;strokeColor=#1b2533;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="630" y="110" width="380" height="1036" as="geometry"/></mxCell><mxCell id="c8" value="ENTRY POINTS (AUTH CHECK)" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontStyle=1;fontColor=#6b7787;" vertex="1" parent="1"><mxGeometry x="642" y="162" width="356" height="18" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;/api/auth&lt;/b&gt;&lt;br&gt;OTP request / verify&lt;br&gt;&lt;b style='color:#1e7e34'&gt;check:&lt;/b&gt; HMAC-SHA256(pepper, email:code), 5 min, 5 attempts, rate limits" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#9aa5b4;" vertex="1" parent="1"><mxGeometry x="642" y="184" width="356" height="70" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;/api/signups, /api/companies, /api/merchants&lt;/b&gt;&lt;br&gt;&lt;b style='color:#1e7e34'&gt;check:&lt;/b&gt; current_ao: SHA-256(token) in ao_sessions, not expired or revoked; owner match" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#9aa5b4;" vertex="1" parent="1"><mxGeometry x="642" y="264" width="356" height="70" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;/api/admin/*&lt;/b&gt;&lt;br&gt;&lt;b style='color:#1e7e34'&gt;check:&lt;/b&gt; require_admin: constant-time compare with CORPONE_ADMIN_TOKEN" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#9aa5b4;" vertex="1" parent="1"><mxGeometry x="642" y="344" width="356" height="70" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;/gateway/v1/*&lt;/b&gt;&lt;br&gt;&lt;b style='color:#1e7e34'&gt;check:&lt;/b&gt; key prefix lookup, constant-time compare SHA-256(secret), active, scope, per-key rate limit, audit row" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#9aa5b4;" vertex="1" parent="1"><mxGeometry x="642" y="424" width="356" height="70" as="geometry"/></mxCell><mxCell id="c13" value="OUTBOUND" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontStyle=1;fontColor=#6b7787;" vertex="1" parent="1"><mxGeometry x="642" y="504" width="356" height="18" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;Outbound gateway&lt;/b&gt; (network, billing, ai)&lt;br&gt;retries + backoff, circuit breaker, rate limit, outbound_call_logs" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#9aa5b4;" vertex="1" parent="1"><mxGeometry x="642" y="526" width="356" height="56" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;boto3 / smtplib / SDK clients&lt;/b&gt;&lt;br&gt;S3, SES, SMTP, Anthropic, Bedrock" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#9aa5b4;" vertex="1" parent="1"><mxGeometry x="642" y="592" width="356" height="50" as="geometry"/></mxCell><mxCell id="c16" value="NEVER LOGGED" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontStyle=1;fontColor=#6b7787;" vertex="1" parent="1"><mxGeometry x="642" y="652" width="356" height="18" as="geometry"/></mxCell><mxCell id="c17" value="request/response bodies, OTP codes, tokens, API keys (log line has method, path, status, ms, caller, request ID only)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#9aa5b4;" vertex="1" parent="1"><mxGeometry x="642" y="674" width="356" height="56" as="geometry"/></mxCell><mxCell id="c18" value='&lt;b&gt;Account officer&lt;/b&gt;&lt;br&gt;&lt;span style="color:#5b6675;"&gt;browser · sign-up portal&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;spacingRight=6;fontSize=11;fillColor=#e8f0fe;strokeColor=#0a58ca;strokeWidth=1.5;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="148" width="210" height="64" as="geometry"/></mxCell><mxCell id="c19" value='&lt;span style="background:#1b2533;color:#fff;font-size:10px;font-weight:bold;"&gt;&amp;nbsp;I1&amp;nbsp;&lt;/span&gt;&amp;nbsp;&lt;span style="color:#3c4858;"&gt;HTTPS · /api/auth then /api/signups&lt;/span&gt;&lt;br&gt;&lt;b style="color:#7c4a03;"&gt;KEY · Email OTP, then session&lt;/b&gt;&lt;br&gt;6-digit code to the email, then cookie &lt;span style="font-family:Consolas,Menlo,monospace;font-size:10px;"&gt;corpone_session&lt;/span&gt; (HttpOnly, SameSite=Strict, 8 h, Secure in prod) or &lt;span style="font-family:Consolas,Menlo,monospace;font-size:10px;"&gt;Authorization: Bearer &amp;lt;session token&amp;gt;&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:10px;font-weight:bold;color:#8a4b00;"&gt;DEV: fixed code 123456 for one test email&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;spacingRight=6;fontSize=11;fillColor=#fffbea;strokeColor=#b7791f;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="270" y="110" width="330" height="136" as="geometry"/></mxCell><mxCell id="l20" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#9aa5b4;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c18" target="c19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="l21" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#9aa5b4;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c19" target="c9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c22" value='&lt;b&gt;Back office user&lt;/b&gt;&lt;br&gt;&lt;span style="color:#5b6675;"&gt;browser · admin page&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;spacingRight=6;fontSize=11;fillColor=#e8f0fe;strokeColor=#0a58ca;strokeWidth=1.5;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="298" width="210" height="64" as="geometry"/></mxCell><mxCell id="c23" value="&lt;span style=&quot;background:#1b2533;color:#fff;font-size:10px;font-weight:bold;&quot;&gt;&amp;nbsp;I2&amp;nbsp;&lt;/span&gt;&amp;nbsp;&lt;span style=&quot;color:#3c4858;&quot;&gt;HTTPS · /api/admin/*&lt;/span&gt;&lt;br&gt;&lt;b style=&quot;color:#7c4a03;&quot;&gt;KEY · Admin token&lt;/b&gt;&lt;br&gt;header &lt;span style=&quot;font-family:Consolas,Menlo,monospace;font-size:10px;&quot;&gt;X-Admin-Token&lt;/span&gt; = &lt;span style=&quot;font-family:Consolas,Menlo,monospace;font-size:10px;&quot;&gt;CORPONE_ADMIN_TOKEN&lt;/span&gt;; kept in the tab's sessionStorage&lt;br&gt;&lt;span style=&quot;font-size:10px;font-weight:bold;color:#9b1c1c;&quot;&gt;GAP: one shared token, no per-user identity&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;spacingRight=6;fontSize=11;fillColor=#fffbea;strokeColor=#b7791f;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="270" y="260" width="330" height="136" as="geometry"/></mxCell><mxCell id="l24" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#9aa5b4;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c22" target="c23"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="l25" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#9aa5b4;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c23" target="c11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c26" value='&lt;b&gt;Partner system&lt;/b&gt;&lt;br&gt;&lt;span style="color:#5b6675;"&gt;dealer CRM, ops tools&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;spacingRight=6;fontSize=11;fillColor=#e8f0fe;strokeColor=#0a58ca;strokeWidth=1.5;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="448" width="210" height="64" as="geometry"/></mxCell><mxCell id="c27" value='&lt;span style="background:#1b2533;color:#fff;font-size:10px;font-weight:bold;"&gt;&amp;nbsp;I3&amp;nbsp;&lt;/span&gt;&amp;nbsp;&lt;span style="color:#3c4858;"&gt;HTTPS · /gateway/v1/*&lt;/span&gt;&lt;br&gt;&lt;b style="color:#7c4a03;"&gt;KEY · Partner API key&lt;/b&gt;&lt;br&gt;&lt;span style="font-family:Consolas,Menlo,monospace;font-size:10px;"&gt;X-API-Key: cpk_&amp;lt;prefix&amp;gt;_&amp;lt;secret&amp;gt;&lt;/span&gt; or &lt;span style="font-family:Consolas,Menlo,monospace;font-size:10px;"&gt;Authorization: Bearer cpk_…&lt;/span&gt;; issued in the back office, shown once; scopes and rate limit per key' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;spacingRight=6;fontSize=11;fillColor=#fffbea;strokeColor=#b7791f;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="270" y="410" width="330" height="136" as="geometry"/></mxCell><mxCell id="l28" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#9aa5b4;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c26" target="c27"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="l29" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#9aa5b4;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c27" target="c12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c30" value='&lt;b&gt;mcp_server&lt;/b&gt;&lt;br&gt;&lt;span style="color:#5b6675;"&gt;MCP tools for AI agents (stdio or :8000/mcp)&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;spacingRight=6;fontSize=11;fillColor=#e8f0fe;strokeColor=#0a58ca;strokeWidth=1.5;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="598" width="210" height="64" as="geometry"/></mxCell><mxCell id="c31" value='&lt;span style="background:#1b2533;color:#fff;font-size:10px;font-weight:bold;"&gt;&amp;nbsp;I4&amp;nbsp;&lt;/span&gt;&amp;nbsp;&lt;span style="color:#3c4858;"&gt;HTTPS · /gateway/v1/* (same path as partners)&lt;/span&gt;&lt;br&gt;&lt;b style="color:#7c4a03;"&gt;KEY · Gateway API key&lt;/b&gt;&lt;br&gt;&lt;span style="font-family:Consolas,Menlo,monospace;font-size:10px;"&gt;CORPONE_GATEWAY_API_KEY&lt;/span&gt; sent as &lt;span style="font-family:Consolas,Menlo,monospace;font-size:10px;"&gt;Authorization: Bearer cpk_…&lt;/span&gt; to &lt;span style="font-family:Consolas,Menlo,monospace;font-size:10px;"&gt;CORPONE_GATEWAY_URL&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:10px;font-weight:bold;color:#073f91;"&gt;PROD: read-only scopes, key in AgentCore Identity or Secrets Manager&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;spacingRight=6;fontSize=11;fillColor=#fffbea;strokeColor=#b7791f;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="270" y="560" width="330" height="136" as="geometry"/></mxCell><mxCell id="l32" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#9aa5b4;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c30" target="c31"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="l33" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#9aa5b4;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c31" target="c12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c34" value='&lt;b&gt;AI agent&lt;/b&gt;&lt;br&gt;&lt;span style="color:#5b6675;"&gt;Claude Desktop / Code, Strands agent, AgentCore&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;spacingRight=6;fontSize=11;fillColor=#e8f0fe;strokeColor=#0a58ca;strokeWidth=1.5;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="748" width="210" height="64" as="geometry"/></mxCell><mxCell id="c35" value='&lt;span style="background:#1b2533;color:#fff;font-size:10px;font-weight:bold;"&gt;&amp;nbsp;I5&amp;nbsp;&lt;/span&gt;&amp;nbsp;&lt;span style="color:#3c4858;"&gt;MCP · to mcp_server (not to the app)&lt;/span&gt;&lt;br&gt;&lt;b style="color:#7c4a03;"&gt;KEY · Agent to MCP server&lt;/b&gt;&lt;br&gt;stdio: local process, no network credential&lt;br&gt;&lt;span style="font-size:10px;font-weight:bold;color:#5b21b6;"&gt;PROPOSED: AgentCore Runtime / Gateway with Cognito JWT or IAM SigV4&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;spacingRight=6;fontSize=11;fillColor=#fffbea;strokeColor=#b7791f;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="270" y="710" width="330" height="136" as="geometry"/></mxCell><mxCell id="l36" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#9aa5b4;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c34" target="c35"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="l37" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#9aa5b4;strokeWidth=1.5;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="c35" target="c30"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c38" value="&lt;b&gt;Edge (test):&lt;/b&gt; browser, then CloudFront (HTTPS), then nginx :80, then &lt;span style=&quot;font-family:Consolas,Menlo,monospace;font-size:10px;&quot;&gt;/ports/8501/&lt;/span&gt; to the app. This path has &lt;b&gt;no login of its own&lt;/b&gt;; every API call is still checked by the app (I1–I3). API responses are &lt;span style=&quot;font-family:Consolas,Menlo,monospace;font-size:10px;&quot;&gt;no-store, private&lt;/span&gt; so CloudFront never caches them.&lt;br&gt;&lt;span style=&quot;font-size:10px;font-weight:bold;color:#9b1c1c;&quot;&gt;GAP: behind nginx the client IP is the proxy's&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;font-weight:bold;color:#073f91;&quot;&gt;PROD: load balancer over HTTPS; trust X-Forwarded-For from it only&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;spacingRight=6;fontSize=11;fillColor=#fffaf2;strokeColor=#c77700;dashed=1;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="868" width="570" height="120" as="geometry"/></mxCell><mxCell id="c39" value='&lt;b&gt;eSIM data in&lt;/b&gt;&lt;br&gt;&lt;span style="color:#5b6675;"&gt;SIM CSV: smdp_address, matching_id&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;spacingRight=6;fontSize=11;fillColor=#e8f0fe;strokeColor=#0a58ca;strokeWidth=1.5;verticalAlign=middle;dashed=1;" vertex="1" parent="1"><mxGeometry x="30" y="1048" width="210" height="64" as="geometry"/></mxCell><mxCell id="c40" value="&lt;span style=&quot;background:#1b2533;color:#fff;font-size:10px;font-weight:bold;&quot;&gt;&amp;nbsp;D1&amp;nbsp;&lt;/span&gt;&amp;nbsp;&lt;span style=&quot;color:#3c4858;&quot;&gt;upload via I2 / I3 / portal SIM upload&lt;/span&gt;&lt;br&gt;&lt;b style=&quot;color:#5b6675;&quot;&gt;NONE · Activation code, not a key&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-family:Consolas,Menlo,monospace;font-size:10px;&quot;&gt;LPA:1$&amp;lt;SM-DP+&amp;gt;$&amp;lt;MatchingID&amp;gt;&lt;/span&gt; built per eSIM; QR emailed only to the AO's verified login email (O3)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;spacingRight=6;fontSize=11;fillColor=#f7f8fa;strokeColor=#c4ccd8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="270" y="1010" width="330" height="136" as="geometry"/></mxCell><mxCell id="l41" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#9aa5b4;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c39" target="c40"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="l42" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#9aa5b4;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.93;entryDx=0;entryDy=0;" edge="1" parent="1" source="c40" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c43" value='&lt;span style="background:#1b2533;color:#fff;font-size:10px;font-weight:bold;"&gt;&amp;nbsp;O1&amp;nbsp;&lt;/span&gt;&amp;nbsp;&lt;span style="color:#3c4858;"&gt;SQLAlchemy · CORPONE_DATABASE_URL&lt;/span&gt;&lt;br&gt;&lt;b style="color:#7c4a03;"&gt;KEY · Database URL&lt;/b&gt;&lt;br&gt;SQLite file: no credential&lt;br&gt;&lt;span style="font-size:10px;font-weight:bold;color:#073f91;"&gt;PROD: Postgres user/password from Secrets Manager or IAM auth, TLS&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;spacingRight=6;fontSize=11;fillColor=#fffbea;strokeColor=#b7791f;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1040" y="110" width="340" height="136" as="geometry"/></mxCell><mxCell id="c44" value='&lt;b&gt;Database&lt;/b&gt;&lt;br&gt;&lt;span style="color:#5b6675;"&gt;SQLite data/corpone.db&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:10px;font-weight:bold;color:#073f91;"&gt;PROD: RDS Postgres&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;spacingRight=6;fontSize=11;fillColor=#e7f6ec;strokeColor=#1e7e34;strokeWidth=1.5;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1410" y="144" width="230" height="72" as="geometry"/></mxCell><mxCell id="l45" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#9aa5b4;strokeWidth=1.5;exitX=1;exitY=0.06563706563706563;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c7" target="c43"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="l46" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#9aa5b4;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c43" target="c44"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c47" value='&lt;span style="background:#1b2533;color:#fff;font-size:10px;font-weight:bold;"&gt;&amp;nbsp;O2&amp;nbsp;&lt;/span&gt;&amp;nbsp;&lt;span style="color:#3c4858;"&gt;HTTPS · S3 PutObject · SSE AES256&lt;/span&gt;&lt;br&gt;&lt;b style="color:#7c4a03;"&gt;KEY · AWS credentials&lt;/b&gt;&lt;br&gt;boto3 default chain (env, profile, instance or task role); bucket &lt;span style="font-family:Consolas,Menlo,monospace;font-size:10px;"&gt;CORPONE_S3_BUCKET&lt;/span&gt;, region &lt;span style="font-family:Consolas,Menlo,monospace;font-size:10px;"&gt;CORPONE_AWS_REGION&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:10px;font-weight:bold;color:#073f91;"&gt;PROD: IAM role with s3:PutObject on the bucket only&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;spacingRight=6;fontSize=11;fillColor=#fffbea;strokeColor=#b7791f;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1040" y="260" width="340" height="136" as="geometry"/></mxCell><mxCell id="c48" value='&lt;b&gt;Contracts store&lt;/b&gt;&lt;br&gt;&lt;span style="color:#5b6675;"&gt;Amazon S3 (encrypted)&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:10px;font-weight:bold;color:#8a4b00;"&gt;DEV: local data/uploads/&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;spacingRight=6;fontSize=11;fillColor=#fff4e5;strokeColor=#c77700;strokeWidth=1.5;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1410" y="294" width="230" height="72" as="geometry"/></mxCell><mxCell id="l49" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#9aa5b4;strokeWidth=1.5;exitX=1;exitY=0.21042471042471042;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c7" target="c47"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="l50" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#9aa5b4;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c47" target="c48"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c51" value='&lt;span style="background:#1b2533;color:#fff;font-size:10px;font-weight:bold;"&gt;&amp;nbsp;O3&amp;nbsp;&lt;/span&gt;&amp;nbsp;&lt;span style="color:#3c4858;"&gt;Email · sign-in codes, eSIM QR codes&lt;/span&gt;&lt;br&gt;&lt;b style="color:#7c4a03;"&gt;KEY · SES or SMTP&lt;/b&gt;&lt;br&gt;SES: AWS credential chain (ses:SendRawEmail). SMTP: &lt;span style="font-family:Consolas,Menlo,monospace;font-size:10px;"&gt;CORPONE_SMTP_HOST/PORT/USER/PASSWORD&lt;/span&gt;, STARTTLS. From &lt;span style="font-family:Consolas,Menlo,monospace;font-size:10px;"&gt;CORPONE_EMAIL_FROM&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:10px;font-weight:bold;color:#8a4b00;"&gt;DEV: .eml files, no credential&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;spacingRight=6;fontSize=11;fillColor=#fffbea;strokeColor=#b7791f;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1040" y="410" width="340" height="136" as="geometry"/></mxCell><mxCell id="c52" value='&lt;b&gt;Email delivery&lt;/b&gt;&lt;br&gt;&lt;span style="color:#5b6675;"&gt;Amazon SES or SMTP relay&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:10px;font-weight:bold;color:#8a4b00;"&gt;DEV: data/outbox/*.eml&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;spacingRight=6;fontSize=11;fillColor=#fff4e5;strokeColor=#c77700;strokeWidth=1.5;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1410" y="444" width="230" height="72" as="geometry"/></mxCell><mxCell id="l53" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#9aa5b4;strokeWidth=1.5;exitX=1;exitY=0.3552123552123552;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c7" target="c51"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="l54" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#9aa5b4;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c51" target="c52"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c55" value='&lt;span style="background:#1b2533;color:#fff;font-size:10px;font-weight:bold;"&gt;&amp;nbsp;O4&amp;nbsp;&lt;/span&gt;&amp;nbsp;&lt;span style="color:#3c4858;"&gt;HTTPS POST · line activation&lt;/span&gt;&lt;br&gt;&lt;b style="color:#7c4a03;"&gt;KEY · Telco API key&lt;/b&gt;&lt;br&gt;&lt;span style="font-family:Consolas,Menlo,monospace;font-size:10px;"&gt;Authorization: Bearer CORPONE_TELCO_API_KEY&lt;/span&gt; to &lt;span style="font-family:Consolas,Menlo,monospace;font-size:10px;"&gt;CORPONE_NETWORK_API_BASE_URL&lt;/span&gt;; &lt;span style="font-family:Consolas,Menlo,monospace;font-size:10px;"&gt;Idempotency-Key: line-&amp;lt;id&amp;gt;-network&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:10px;font-weight:bold;color:#8a4b00;"&gt;DEV: mock, no call&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;spacingRight=6;fontSize=11;fillColor=#fffbea;strokeColor=#b7791f;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1040" y="560" width="340" height="136" as="geometry"/></mxCell><mxCell id="c56" value='&lt;b&gt;Network API&lt;/b&gt;&lt;br&gt;&lt;span style="color:#5b6675;"&gt;activates SIM + number&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;spacingRight=6;fontSize=11;fillColor=#f1f3f6;strokeColor=#6b7787;strokeWidth=1.5;dashed=1;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1410" y="594" width="230" height="72" as="geometry"/></mxCell><mxCell id="l57" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#9aa5b4;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c7" target="c55"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="l58" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#9aa5b4;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c55" target="c56"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c59" value='&lt;span style="background:#1b2533;color:#fff;font-size:10px;font-weight:bold;"&gt;&amp;nbsp;O5&amp;nbsp;&lt;/span&gt;&amp;nbsp;&lt;span style="color:#3c4858;"&gt;HTTPS POST · billing account, subscriptions&lt;/span&gt;&lt;br&gt;&lt;b style="color:#7c4a03;"&gt;KEY · Telco API key&lt;/b&gt;&lt;br&gt;same &lt;span style="font-family:Consolas,Menlo,monospace;font-size:10px;"&gt;CORPONE_TELCO_API_KEY&lt;/span&gt; to &lt;span style="font-family:Consolas,Menlo,monospace;font-size:10px;"&gt;CORPONE_BILLING_API_BASE_URL&lt;/span&gt;; &lt;span style="font-family:Consolas,Menlo,monospace;font-size:10px;"&gt;Idempotency-Key: account-&amp;lt;id&amp;gt;&lt;/span&gt;, &lt;span style="font-family:Consolas,Menlo,monospace;font-size:10px;"&gt;line-&amp;lt;id&amp;gt;-billing&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:10px;font-weight:bold;color:#8a4b00;"&gt;DEV: mock&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;spacingRight=6;fontSize=11;fillColor=#fffbea;strokeColor=#b7791f;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1040" y="710" width="340" height="136" as="geometry"/></mxCell><mxCell id="c60" value='&lt;b&gt;Billing API&lt;/b&gt;&lt;br&gt;&lt;span style="color:#5b6675;"&gt;accounts, subscriptions&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;spacingRight=6;fontSize=11;fillColor=#f1f3f6;strokeColor=#6b7787;strokeWidth=1.5;dashed=1;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1410" y="744" width="230" height="72" as="geometry"/></mxCell><mxCell id="l61" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#9aa5b4;strokeWidth=1.5;exitX=1;exitY=0.6447876447876448;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c7" target="c59"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="l62" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#9aa5b4;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c59" target="c60"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c63" value='&lt;span style="background:#1b2533;color:#fff;font-size:10px;font-weight:bold;"&gt;&amp;nbsp;O6&amp;nbsp;&lt;/span&gt;&amp;nbsp;&lt;span style="color:#3c4858;"&gt;HTTPS · Messages API · contract review&lt;/span&gt;&lt;br&gt;&lt;b style="color:#7c4a03;"&gt;KEY · Anthropic API key&lt;/b&gt;&lt;br&gt;&lt;span style="font-family:Consolas,Menlo,monospace;font-size:10px;"&gt;ANTHROPIC_API_KEY&lt;/span&gt; (read by the SDK) when &lt;span style="font-family:Consolas,Menlo,monospace;font-size:10px;"&gt;CORPONE_AI_PROVIDER=anthropic&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:10px;font-weight:bold;color:#8a4b00;"&gt;DEV: AI disabled&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;spacingRight=6;fontSize=11;fillColor=#fffbea;strokeColor=#b7791f;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1040" y="860" width="340" height="136" as="geometry"/></mxCell><mxCell id="c64" value='&lt;b&gt;Claude · Anthropic API&lt;/b&gt;&lt;br&gt;&lt;span style="color:#5b6675;"&gt;advisory contract check&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;spacingRight=6;fontSize=11;fillColor=#f1f3f6;strokeColor=#6b7787;strokeWidth=1.5;dashed=1;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1410" y="894" width="230" height="72" as="geometry"/></mxCell><mxCell id="l65" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#9aa5b4;strokeWidth=1.5;exitX=1;exitY=0.7895752895752896;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c7" target="c63"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="l66" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#9aa5b4;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c63" target="c64"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c67" value='&lt;span style="background:#1b2533;color:#fff;font-size:10px;font-weight:bold;"&gt;&amp;nbsp;O7&amp;nbsp;&lt;/span&gt;&amp;nbsp;&lt;span style="color:#3c4858;"&gt;HTTPS · Bedrock (Mantle client) · contract review&lt;/span&gt;&lt;br&gt;&lt;b style="color:#7c4a03;"&gt;KEY · AWS credentials&lt;/b&gt;&lt;br&gt;AWS credential chain (bedrock:InvokeModel) when &lt;span style="font-family:Consolas,Menlo,monospace;font-size:10px;"&gt;CORPONE_AI_PROVIDER=bedrock&lt;/span&gt;; fallback model &lt;span style="font-family:Consolas,Menlo,monospace;font-size:10px;"&gt;CORPONE_AI_BEDROCK_FALLBACK_MODEL&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;spacingRight=6;fontSize=11;fillColor=#fffbea;strokeColor=#b7791f;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1040" y="1010" width="340" height="136" as="geometry"/></mxCell><mxCell id="c68" value='&lt;b&gt;Claude · Amazon Bedrock&lt;/b&gt;&lt;br&gt;&lt;span style="color:#5b6675;"&gt;same review, AWS-hosted&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;spacingRight=6;fontSize=11;fillColor=#fff4e5;strokeColor=#c77700;strokeWidth=1.5;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1410" y="1044" width="230" height="72" as="geometry"/></mxCell><mxCell id="l69" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#9aa5b4;strokeWidth=1.5;exitX=1;exitY=0.9343629343629344;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c7" target="c67"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="l70" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#9aa5b4;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c67" target="c68"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c71" value="&lt;span style=&quot;font-size:16px;font-weight:bold;&quot;&gt;Key and secret register&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5b6675;&quot;&gt;Where each credential lives today, how the app stores or checks it, and what production should use.&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;table style=&quot;border-collapse:collapse;width:100%;&quot;&gt;&lt;tr&gt;&lt;th style=&quot;border:1px solid #dfe4ec;padding:4px 6px;background:#f1f3f6;text-align:left;font-size:10px;color:#3c4858;&quot;&gt;#&lt;/th&gt;&lt;th style=&quot;border:1px solid #dfe4ec;padding:4px 6px;background:#f1f3f6;text-align:left;font-size:10px;color:#3c4858;&quot;&gt;Credential&lt;/th&gt;&lt;th style=&quot;border:1px solid #dfe4ec;padding:4px 6px;background:#f1f3f6;text-align:left;font-size:10px;color:#3c4858;&quot;&gt;Setting / header&lt;/th&gt;&lt;th style=&quot;border:1px solid #dfe4ec;padding:4px 6px;background:#f1f3f6;text-align:left;font-size:10px;color:#3c4858;&quot;&gt;Used for&lt;/th&gt;&lt;th style=&quot;border:1px solid #dfe4ec;padding:4px 6px;background:#f1f3f6;text-align:left;font-size:10px;color:#3c4858;&quot;&gt;How it's stored or checked&lt;/th&gt;&lt;th style=&quot;border:1px solid #dfe4ec;padding:4px 6px;background:#f1f3f6;text-align:left;font-size:10px;color:#3c4858;&quot;&gt;Today (test)&lt;/th&gt;&lt;th style=&quot;border:1px solid #dfe4ec;padding:4px 6px;background:#f1f3f6;text-align:left;font-size:10px;color:#3c4858;&quot;&gt;Production&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #dfe4ec;padding:4px 6px;vertical-align:top;font-size:11px;&quot;&gt;I1&lt;/td&gt;&lt;td style=&quot;border:1px solid #dfe4ec;padding:4px 6px;vertical-align:top;font-size:11px;&quot;&gt;Sign-in code&lt;/td&gt;&lt;td style=&quot;border:1px solid #dfe4ec;padding:4px 6px;vertical-align:top;font-size:11px;&quot;&gt;email · CORPONE_OTP_PEPPER&lt;/td&gt;&lt;td style=&quot;border:1px solid #dfe4ec;padding:4px 6px;vertical-align:top;font-size:11px;&quot;&gt;AO sign-in&lt;/td&gt;&lt;td style=&quot;border:1px solid #dfe4ec;padding:4px 6px;vertical-align:top;font-size:11px;&quot;&gt;Only HMAC-SHA256(pepper, email:code) stored; 5 min, single use, 5 attempts&lt;/td&gt;&lt;td style=&quot;border:1px solid #dfe4ec;padding:4px 6px;vertical-align:top;font-size:11px;&quot;&gt;random per request; fixed 123456 for admin@corp1.com.sg&lt;/td&gt;&lt;td style=&quot;border:1px solid #dfe4ec;padding:4px 6px;vertical-align:top;font-size:11px;&quot;&gt;pepper from Secrets Manager; fixed code never set&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #dfe4ec;padding:4px 6px;vertical-align:top;font-size:11px;&quot;&gt;I1&lt;/td&gt;&lt;td style=&quot;border:1px solid #dfe4ec;padding:4px 6px;vertical-align:top;font-size:11px;&quot;&gt;Session token&lt;/td&gt;&lt;td style=&quot;border:1px solid #dfe4ec;padding:4px 6px;vertical-align:top;font-size:11px;&quot;&gt;cookie corpone_session / Bearer&lt;/td&gt;&lt;td style=&quot;border:1px solid #dfe4ec;padding:4px 6px;vertical-align:top;font-size:11px;&quot;&gt;AO API calls&lt;/td&gt;&lt;td style=&quot;border:1px solid #dfe4ec;padding:4px 6px;vertical-align:top;font-size:11px;&quot;&gt;32 random bytes; only SHA-256 stored in ao_sessions; 8 h; revoked on logout&lt;/td&gt;&lt;td style=&quot;border:1px solid #dfe4ec;padding:4px 6px;vertical-align:top;font-size:11px;&quot;&gt;cookie without Secure flag&lt;/td&gt;&lt;td style=&quot;border:1px solid #dfe4ec;padding:4px 6px;vertical-align:top;font-size:11px;&quot;&gt;CORPONE_COOKIE_SECURE=true over HTTPS&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #dfe4ec;padding:4px 6px;vertical-align:top;font-size:11px;&quot;&gt;I2&lt;/td&gt;&lt;td style=&quot;border:1px solid #dfe4ec;padding:4px 6px;vertical-align:top;font-size:11px;&quot;&gt;Admin token&lt;/td&gt;&lt;td style=&quot;border:1px solid #dfe4ec;padding:4px 6px;vertical-align:top;font-size:11px;&quot;&gt;X-Admin-Token · CORPONE_ADMIN_TOKEN&lt;/td&gt;&lt;td style=&quot;border:1px solid #dfe4ec;padding:4px 6px;vertical-align:top;font-size:11px;&quot;&gt;whole back office&lt;/td&gt;&lt;td style=&quot;border:1px solid #dfe4ec;padding:4px 6px;vertical-align:top;font-size:11px;&quot;&gt;constant-time compare with the env value; browser keeps it in sessionStorage&lt;/td&gt;&lt;td style=&quot;border:1px solid #dfe4ec;padding:4px 6px;vertical-align:top;font-size:11px;&quot;&gt;random token set at server start&lt;/td&gt;&lt;td style=&quot;border:1px solid #dfe4ec;padding:4px 6px;vertical-align:top;font-size:11px;&quot;&gt;Secrets Manager + rotation; better: per-user SSO (IAM Identity Center / OIDC)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #dfe4ec;padding:4px 6px;vertical-align:top;font-size:11px;&quot;&gt;I3, I4&lt;/td&gt;&lt;td style=&quot;border:1px solid #dfe4ec;padding:4px 6px;vertical-align:top;font-size:11px;&quot;&gt;Gateway API key&lt;/td&gt;&lt;td style=&quot;border:1px solid #dfe4ec;padding:4px 6px;vertical-align:top;font-size:11px;&quot;&gt;X-API-Key / Bearer cpk_… · CORPONE_GATEWAY_API_KEY&lt;/td&gt;&lt;td style=&quot;border:1px solid #dfe4ec;padding:4px 6px;vertical-align:top;font-size:11px;&quot;&gt;partners, MCP server&lt;/td&gt;&lt;td style=&quot;border:1px solid #dfe4ec;padding:4px 6px;vertical-align:top;font-size:11px;&quot;&gt;prefix + SHA-256 of secret stored; shown once; scopes, per-key rate limit, revocable, audited&lt;/td&gt;&lt;td style=&quot;border:1px solid #dfe4ec;padding:4px 6px;vertical-align:top;font-size:11px;&quot;&gt;issued in back office&lt;/td&gt;&lt;td style=&quot;border:1px solid #dfe4ec;padding:4px 6px;vertical-align:top;font-size:11px;&quot;&gt;one key per client, least scopes; caller keeps it in Secrets Manager / AgentCore Identity&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #dfe4ec;padding:4px 6px;vertical-align:top;font-size:11px;&quot;&gt;I5&lt;/td&gt;&lt;td style=&quot;border:1px solid #dfe4ec;padding:4px 6px;vertical-align:top;font-size:11px;&quot;&gt;Agent identity&lt;/td&gt;&lt;td style=&quot;border:1px solid #dfe4ec;padding:4px 6px;vertical-align:top;font-size:11px;&quot;&gt;JWT or SigV4&lt;/td&gt;&lt;td style=&quot;border:1px solid #dfe4ec;padding:4px 6px;vertical-align:top;font-size:11px;&quot;&gt;agent to MCP server&lt;/td&gt;&lt;td style=&quot;border:1px solid #dfe4ec;padding:4px 6px;vertical-align:top;font-size:11px;&quot;&gt;checked by AgentCore (not by the app)&lt;/td&gt;&lt;td style=&quot;border:1px solid #dfe4ec;padding:4px 6px;vertical-align:top;font-size:11px;&quot;&gt;stdio, local only&lt;/td&gt;&lt;td style=&quot;border:1px solid #dfe4ec;padding:4px 6px;vertical-align:top;font-size:11px;&quot;&gt;Cognito client-credentials JWT or IAM&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #dfe4ec;padding:4px 6px;vertical-align:top;font-size:11px;&quot;&gt;O1&lt;/td&gt;&lt;td style=&quot;border:1px solid #dfe4ec;padding:4px 6px;vertical-align:top;font-size:11px;&quot;&gt;Database credential&lt;/td&gt;&lt;td style=&quot;border:1px solid #dfe4ec;padding:4px 6px;vertical-align:top;font-size:11px;&quot;&gt;CORPONE_DATABASE_URL&lt;/td&gt;&lt;td style=&quot;border:1px solid #dfe4ec;padding:4px 6px;vertical-align:top;font-size:11px;&quot;&gt;all data&lt;/td&gt;&lt;td style=&quot;border:1px solid #dfe4ec;padding:4px 6px;vertical-align:top;font-size:11px;&quot;&gt;connection string&lt;/td&gt;&lt;td style=&quot;border:1px solid #dfe4ec;padding:4px 6px;vertical-align:top;font-size:11px;&quot;&gt;SQLite file&lt;/td&gt;&lt;td style=&quot;border:1px solid #dfe4ec;padding:4px 6px;vertical-align:top;font-size:11px;&quot;&gt;Postgres secret in Secrets Manager or IAM DB auth; TLS&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #dfe4ec;padding:4px 6px;vertical-align:top;font-size:11px;&quot;&gt;O2, O3, O7&lt;/td&gt;&lt;td style=&quot;border:1px solid #dfe4ec;padding:4px 6px;vertical-align:top;font-size:11px;&quot;&gt;AWS credentials&lt;/td&gt;&lt;td style=&quot;border:1px solid #dfe4ec;padding:4px 6px;vertical-align:top;font-size:11px;&quot;&gt;boto3 / SDK default chain&lt;/td&gt;&lt;td style=&quot;border:1px solid #dfe4ec;padding:4px 6px;vertical-align:top;font-size:11px;&quot;&gt;S3, SES, Bedrock&lt;/td&gt;&lt;td style=&quot;border:1px solid #dfe4ec;padding:4px 6px;vertical-align:top;font-size:11px;&quot;&gt;never stored by the app&lt;/td&gt;&lt;td style=&quot;border:1px solid #dfe4ec;padding:4px 6px;vertical-align:top;font-size:11px;&quot;&gt;not used (local storage, console email, AI off)&lt;/td&gt;&lt;td style=&quot;border:1px solid #dfe4ec;padding:4px 6px;vertical-align:top;font-size:11px;&quot;&gt;IAM role (ECS task / EC2 instance), least privilege; no access keys in env&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #dfe4ec;padding:4px 6px;vertical-align:top;font-size:11px;&quot;&gt;O3&lt;/td&gt;&lt;td style=&quot;border:1px solid #dfe4ec;padding:4px 6px;vertical-align:top;font-size:11px;&quot;&gt;SMTP password&lt;/td&gt;&lt;td style=&quot;border:1px solid #dfe4ec;padding:4px 6px;vertical-align:top;font-size:11px;&quot;&gt;CORPONE_SMTP_USER / _PASSWORD&lt;/td&gt;&lt;td style=&quot;border:1px solid #dfe4ec;padding:4px 6px;vertical-align:top;font-size:11px;&quot;&gt;email via SMTP&lt;/td&gt;&lt;td style=&quot;border:1px solid #dfe4ec;padding:4px 6px;vertical-align:top;font-size:11px;&quot;&gt;env value; STARTTLS&lt;/td&gt;&lt;td style=&quot;border:1px solid #dfe4ec;padding:4px 6px;vertical-align:top;font-size:11px;&quot;&gt;not used&lt;/td&gt;&lt;td style=&quot;border:1px solid #dfe4ec;padding:4px 6px;vertical-align:top;font-size:11px;&quot;&gt;Secrets Manager, or SES with IAM instead&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #dfe4ec;padding:4px 6px;vertical-align:top;font-size:11px;&quot;&gt;O4, O5&lt;/td&gt;&lt;td style=&quot;border:1px solid #dfe4ec;padding:4px 6px;vertical-align:top;font-size:11px;&quot;&gt;Telco API key&lt;/td&gt;&lt;td style=&quot;border:1px solid #dfe4ec;padding:4px 6px;vertical-align:top;font-size:11px;&quot;&gt;Authorization: Bearer · CORPONE_TELCO_API_KEY&lt;/td&gt;&lt;td style=&quot;border:1px solid #dfe4ec;padding:4px 6px;vertical-align:top;font-size:11px;&quot;&gt;Network and Billing APIs&lt;/td&gt;&lt;td style=&quot;border:1px solid #dfe4ec;padding:4px 6px;vertical-align:top;font-size:11px;&quot;&gt;env value; plus Idempotency-Key per call&lt;/td&gt;&lt;td style=&quot;border:1px solid #dfe4ec;padding:4px 6px;vertical-align:top;font-size:11px;&quot;&gt;mock mode, not used&lt;/td&gt;&lt;td style=&quot;border:1px solid #dfe4ec;padding:4px 6px;vertical-align:top;font-size:11px;&quot;&gt;Secrets Manager; separate keys per upstream if supported; mTLS if offered&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #dfe4ec;padding:4px 6px;vertical-align:top;font-size:11px;&quot;&gt;O6&lt;/td&gt;&lt;td style=&quot;border:1px solid #dfe4ec;padding:4px 6px;vertical-align:top;font-size:11px;&quot;&gt;Anthropic API key&lt;/td&gt;&lt;td style=&quot;border:1px solid #dfe4ec;padding:4px 6px;vertical-align:top;font-size:11px;&quot;&gt;ANTHROPIC_API_KEY&lt;/td&gt;&lt;td style=&quot;border:1px solid #dfe4ec;padding:4px 6px;vertical-align:top;font-size:11px;&quot;&gt;contract review&lt;/td&gt;&lt;td style=&quot;border:1px solid #dfe4ec;padding:4px 6px;vertical-align:top;font-size:11px;&quot;&gt;read by the Anthropic SDK&lt;/td&gt;&lt;td style=&quot;border:1px solid #dfe4ec;padding:4px 6px;vertical-align:top;font-size:11px;&quot;&gt;AI disabled&lt;/td&gt;&lt;td style=&quot;border:1px solid #dfe4ec;padding:4px 6px;vertical-align:top;font-size:11px;&quot;&gt;Secrets Manager, or use Bedrock (O7) with IAM&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #dfe4ec;padding:4px 6px;vertical-align:top;font-size:11px;&quot;&gt;D1&lt;/td&gt;&lt;td style=&quot;border:1px solid #dfe4ec;padding:4px 6px;vertical-align:top;font-size:11px;&quot;&gt;eSIM activation code&lt;/td&gt;&lt;td style=&quot;border:1px solid #dfe4ec;padding:4px 6px;vertical-align:top;font-size:11px;&quot;&gt;SIM CSV smdp_address, matching_id&lt;/td&gt;&lt;td style=&quot;border:1px solid #dfe4ec;padding:4px 6px;vertical-align:top;font-size:11px;&quot;&gt;eSIM QR codes&lt;/td&gt;&lt;td style=&quot;border:1px solid #dfe4ec;padding:4px 6px;vertical-align:top;font-size:11px;&quot;&gt;stored with the SIM; emailed only to the verified AO email&lt;/td&gt;&lt;td style=&quot;border:1px solid #dfe4ec;padding:4px 6px;vertical-align:top;font-size:11px;&quot;&gt;default SM-DP+ smdp.corpone.sg&lt;/td&gt;&lt;td style=&quot;border:1px solid #dfe4ec;padding:4px 6px;vertical-align:top;font-size:11px;&quot;&gt;treat as sensitive: restrict upload, encrypt DB at rest&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=fill;" vertex="1" parent="1"><mxGeometry x="30" y="1186" width="1610" height="430" as="geometry"/></mxCell><mxCell id="c72" value='&lt;span style="font-size:11px;color:#3c4858;"&gt;&lt;b style="color:#7c4a03;"&gt;KEY&lt;/b&gt; credential · &lt;b style="color:#8a4b00;"&gt;DEV&lt;/b&gt; test setup today · &lt;b style="color:#073f91;"&gt;PROD&lt;/b&gt; production recommendation · &lt;b style="color:#5b21b6;"&gt;PROPOSED&lt;/b&gt; not built yet · &lt;b style="color:#9b1c1c;"&gt;GAP&lt;/b&gt; known weakness · blue = callers · green = data · orange = AWS service · dashed grey = external system&lt;/span&gt;' style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="1626" width="1200" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
